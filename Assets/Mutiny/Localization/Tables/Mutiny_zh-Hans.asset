    m_Localized: "\u9009\u62E9\u4E0B\u65B9\u6309\u94AE\uFF1A\n\u4E0E\u7535\u8111\u5BF9\u6218\uFF0C\u6216\u4E0E\u670B\u53CB\u5BF9\u6218\uFF01"
