ConstantPool "_global", "com", "Object", "nitrome", "game", "WeaponSelectButton", "weapon", "_name", "substr", "SimpleButton", "prototype", "onLoad", "updateGraphic", "onRollOver", "hover", "disabled", "hoverText", "hover_", "WeaponSelectPanel", "_parent", "title", "__set__text", "description", "onRollOut", "Weapons", "Click one of the options above|to select it.", "blue", "red", "gotoAndStop", "_over", "_up", "useHandCursor", "onEnterFrame", "throwgame", "Controller", "currentTeam", "selectedCharacter", "number", "throw", "canThrow", "endTurn", "numberOfWeapon", "weaponIsInfinite", "infinity", "_visible", "count", "", "0", "toString", "icon", "onPress", "contentsActive", "unequip", "weaponSelected", "canShoot", "thrown", "throwFinished", "firstIndexOfWeapon", "equip", "hover_cherryBomb", "Basic weak weapon which|explodes on impact.|Click the cherry bomb and drag|with your mouse to aim and set|the power.", "cherry bomb", "hover_dynamite", "This weapon explodes when it|comes to rest.|Click the dynamite and drag|with your mouse to aim and set|the power.", "dynamite", "hover_boulder", "Large boulder which can bash|other players out of the way.|Click the boulder and drag|with your mouse to aim and set|the power.", "boulder", "hover_piecesOfEight", "Eight coins which inflict a small|amount of damage. You get|eight turns with this weapon.|Click each one and drag to aim|and set the power.", "pieces of eight", "hover_rumBottle", "This weapon explodes on impact|and sets the nearby area on fire.|Click it and drag|with your mouse to aim and set|the power.", "rum bottle", "hover_banana", "This weapon is very bouncy.|Click and drag with the mouse|to aim and set the power.|Then click your mouse again to|make it explode.", "banana", "hover_parachuteBomb", "Click and drag with the mouse|to aim and set the power.|As it drifts down use|your cursor as a fan to push it|left or right.", "parachute bomb", "hover_woodenCrate", "Click anywhere on the stage to|place down three crates.|use these to form a wall to|protect your characters.", "crates", "hover_gunpowderBarrel", "Click anywhere on the stage to|place down two barrels.|these will explode when hit by|a weapon.", "gunpowder barrels", "hover_seagull", "Click on the screen to choose a|path for the seagull to fly.|Then click repeatedly to poop|on the enemy!", "seagull", "hover_mine", "Click the mine and drag|with the mouse to aim and|set the power.|It will detonate when|another player moves nearby.", "mine", "hover_cannon", "Drag the cannon into position|within the circle.|click and drag the pin at the|back to turn the cannon.|release it to fire!", "cannon", "hover_anchor", "Click anywhere in the stage to|drop a huge anchor down|onto enemies!", "anchor", "hover_voodooDoll", "choose an enemy player by|clicking on them. then click|and drag to throw the doll and|watch the enemy helplessly|fly off in the same direction!", "voodoo doll", "hover_tidalWave", "click to send a huge tidal wave|across the bottom of the stage.|It will affect all players it|hits.", "tidal wave", "hover_throw", "Click your character and drag|with the mouse to aim and set|the power.|you get to use this once per|turn before you use a weapon.", "throw character", "hover_endTurn", "click here if you want to finish|your turn without using a|weapon.", "end go", "ASSetPropFlags"
