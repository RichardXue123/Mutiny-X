ConstantPool "_global", "com", "Object", "nitrome", "throwgame", "Team", "number", "characters", "game_type", "aiControlled", "prototype", "advance", "aiFinished", "Controller", "currentTeam", "length", "aiThink", "aiMoveList", "concat", "Infinity", "success", "aiCanBailOut", "player", "select", "aiMoveDetails", "best rating: ", "best weapon: ", "weapon", "hasWeapons", "throw", "tileSystem", "panToCharacter", "nextTurn", "equip", "equippedWeapon", "aiPerform", "canThrow", "canShoot", "unequip", "velocityX", "vx", "velocityY", "vy", "thrown", "selectedCharacter", "inactivity", "health", "maxHealth", "root", "team", "Math", "floor", "_currentframe", "util", "Global", "slide", "gotoAndStop", "anyAlive", "alive", "countAlive", "speaker", "Captain", "linkageName", "indexOf", "tribeChief", "getCaptain", "throwFinished", "weaponSelected", "getTeamType", "sfx_manager", "playSound", "unselect", "startTurn", "totalTurnsTaken", "mc", "num", "text", "toString", "aiStart", "_visible", "cannonball", "push", "weaponLocked", "evilness", "cameraX", "x", "cameraY", "y", "red", "blue", "weapons", "Computer, take your turn", "say", "Player ", ", take your turn", "finishTurn", "weaponExpired", "isTurnComplete", "continueTurn", "", "split", "join", "Chief", "getTotalHealth", "getAverageHealth", "destroy", "lines", "squid", "Splund splund... I\'m so|happy I\'ve just inked|myself... splund.", "Yearggh take that you|varmint, we be eating squid|rings tonight.", "Splund splund... I\'m gonna|ink you up... splund splund.", "Arrrgh what sort o\' sea|beastie be this?", "crab", "Looks like they fell for|our deadly pincer|manoeuvre... at last their|beards be ours.", "I think we shell-shocked|them, mateys!", "Prepare to lose your|beards... snip snip!", "Looks like we\'ve got a|bad case of the crabs|here, mateys!", "shark", "Stop! ...Hammer-time!", "Ya Har! \'Twas too easy!|But thar be plenty more|fish in the sea!", "We\'re gonna hammer you!|You\'re Shark Bait!", "Ahoy. I think there be|something fishy here.", "parrot", "Squawk!... Polly want a|cracker!", "Arrrgh... \'tiz a shame.|They could have made fine|shoulder enhancers.", "Squawk!... Who\'s a pretty|boy then? ...Squawk!...|Polly want a cracker!|...Squawk!", "Arrrgh!... Who be a pretty|boy then? ...Does Polly|want a cracker?", "monkey", "Oooh Oooh Ahh Ahh More|Bananas!", "Yarrgh! Yer monkey business|ain\'t foolin\' any of us!", "Oooh Oooh Ahh Ahh Bananas!", "Guard the fruit mateys...|If the monkeys get it we\'ll|be up for another bout|of scurvy!", "soldier", "You pirates will get what|you deserve... a short drop|and a sudden stop!", "They don\'t look so smart|now lads... I think We\'ll|be using his toupee to swab|the decks!", "We fight for King and|Country! ...and because we|get a decent benefits|package and pension plan!", "These boys look too clean|to be in a real fight! And|look... they\'ve still got|teeth to knock out!", "blindPirate", "Gar... I can\'t hear them...|Does anyone know if we|won?", "Yarrgh!|They didn\'t see us coming!", "Get who? Where am I...|how did I get here?", "Yargh... These guys have|one too many eye patches!|This should be easy! Let\'s|get \'em!", "femalePirate", "Yarp... Everybody knows|girls are better than boys!", "Arrgh... shame... what a|waste of such lovely|sea legs!", "Yarp... The only booty you|will be getting is on the|end of my foot!", "Garrrgh... Looks like we\'ve|found ourselves some|mighty fine booty here,|mateys!", "oldPirate", "That\'ll show you... in my|day we used to fight a|Kraken with nothin\' but a|couple o\' stones. Arrrgh...|Those be the days...", "Garrrrgh! Ok, Grandads...|time for your afternoon|nap!", "We\'re not Old, we\'re|experienced... and now we\'re|gonna kick your... erm...|erm... what was I saying|again... who are you?", "Arrrrggggh... I think we|found some old sea dogs!|Ready for retirement!", "rainbowBeard", "Oo-er! Now we\'re finished|with them, it\'s time for a|bit of retail therapy!", "I\'d have beaten you sooner if|your fancy beards didn\'t|keep catchin\' the light!", "Ohhhh look at you... don\'t|you look tough? Anyway,|haven\'t you heard? Fancy|colours are the new black!", "This guy be looking a little|too jolly to be flying the|ol\' jolly roger, eh mateys?", "cabinBoy", "That was fun... just like a|Nitrome video game! LOL!", "Yarrgh! Best be running|along home now boys! I think|it be past yer bedtime?", "We\'re no boys! I had a couple|of hairs only last month on|me chin, just ask me mum!", "Yarrgh! ...ye be wanting to|grow a proper beard before|taking on the likes of us,|boys...", "tribe", "mmmmmmm! can\'t remember|the last time we had a good|pirate stew!|...has anyone got the salt?", "Good work lads! we\'ve|avoided being lunch... looks|like they\'ll have to stick|with mangos and coconuts|from now on!", "Get the cookin\' pot ready...|pirate stew tonight!", "Garrgh! I\'ve got a bad feelin\'|about this lads! They be|lookin\' kinda hungry!", "skeletonPirate", "Sticks and stones may break|my bones but pirates never|hurt me!", "I am rubber, you are glue!", "you\'ll have to catch us all|first ...fatty!", "This crew looks like they|could do with a good feed|more than a fight...", "bossGuy", "These hats \'ll be a mighty|fine addition to my|collection!", "I think he was a little|hot-headed...|maybe it was his hat!", "Argh! ye not be winning with|a hat like that. And once I|win I\'ll be taking your hats.", "Garrrgh! what a big hat...|I think he be trying to|make up for something, lads!", "bossGuyZombie", "Yar hats be mine after all!|hhhhhaaaaattttttss!!!", "Yo-Ho-Ho... we\'ve done it|lads! that finished him off...|eerrrrm didn\'t we?", "aaaaaaaaahhhhhhhh...|hhhhhaaaaattttttss...|errrr... I mean...|bbbbrrraaaiiinnsss...", "I think he\'s been playing|with a few too many|voodoo dolls, lads! he\'s back|from Davey Jones locker.", "ASSetPropFlags"
